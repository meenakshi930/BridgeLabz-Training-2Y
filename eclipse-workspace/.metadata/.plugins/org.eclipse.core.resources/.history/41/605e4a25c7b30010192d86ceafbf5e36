//1. Smart Device Control Interface
//○ Scenario: All devices (lights, AC, TV) should have turnOn() and turnOff()
//methods.
//○ Task: Create an interface and implement it in multiple classes.


package functionalinterface;

import java.util.Scanner;

@FunctionalInterface
 interface Smart {
	void display();
}

public class Smart_Device {
	public static void main(String[] args) {
		Smart light = () -> System.out.println("turn on");
		
		Smart AC = () -> System.out.println("turn on");
		
		Smart tv = () -> System.out.println("turn on");
		
	}
	Scanner input = new Scanner(System.in);
    System.out.print("Enter filter type (light/AC/tv): ");
    String n = input.next();

    if (n.equalsIgnoreCase("light")) {
        light.display();
    } else if (n.equalsIgnoreCase("AC")) {
        AC.display();
    } else if (n.equalsIgnoreCase("tv")) {
        tv.display();
    } else {
        System.out.println("Invalid input!.");
    }

    input.close();
}
		
		
	

}
